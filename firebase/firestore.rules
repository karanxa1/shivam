rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper function to get user role from users collection
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Helper function to check if user is authority
    function isAuthority() {
      return isAuth() && getRole() == "authority";
    }

    // Helper function to check if user is employee
    function isEmployee() {
      return isAuth() && getRole() == "employee";
    }

    // Helper function to check if user is regular
    function isRegular() {
      return isAuth() && getRole() == "regular";
    }

    // Users collection - users can only read/write their own document
    match /users/{uid} {
      allow read, write: if request.auth.uid == uid;
      // Authority can read all users
      allow read: if isAuthority();
    }

    // Transactions collection - users can only access their own transactions
    match /transactions/{txnId} {
      // Read and update existing transactions
      allow read, update, delete: if isAuth() && resource.data.userId == request.auth.uid;
      // Create new transaction with own userId
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      // Authority can read all transactions
      allow read: if isAuthority();
    }

    // Budgets collection - users can only access their own budgets
    match /budgets/{budgetId} {
      allow read, update, delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      // Authority can read all budgets
      allow read: if isAuthority();
    }

    // Employees collection - only authority can write, employees can read their own
    match /employees/{empId} {
      // Authority has full access
      allow read, write: if isAuthority();
      // Employee can read their own employee document
      allow read: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // Projects collection - authority can write, all can read
    match /projects/{projectId} {
      // Authority has full access
      allow read, write: if isAuthority();
      // Employees can read projects (to see assignments)
      allow read: if isAuth();
    }

    // Helper: verify employeeId (Firestore doc ID) belongs to the requesting user
    function isEmployeeOwner(employeeDocId) {
      return isAuth() &&
        employeeDocId != '' &&
        exists(/databases/$(database)/documents/employees/$(employeeDocId)) &&
        get(/databases/$(database)/documents/employees/$(employeeDocId)).data.uid == request.auth.uid;
    }

    // Tasks collection - authority can write, employees can read/update their own
    match /tasks/{taskId} {
      // Authority has full access
      allow read, write: if isAuthority();
      // Employee can read and update (status) their own tasks
      // employeeId stores the Firestore document ID of the employee record
      allow read, update: if isEmployeeOwner(resource.data.employeeId);
    }

    // Payslips collection - authority can write, employees can read their own
    match /payslips/{payslipId} {
      // Authority has full access
      allow read, write: if isAuthority();
      // Employee can read their own payslips only
      // employeeId stores the Firestore document ID of the employee record
      allow read: if isEmployeeOwner(resource.data.employeeId);
    }

    // Notifications collection - users can read/update their own notifications
    match /notifications/{notifId} {
      // Users can read and update (mark as read) their own notifications
      allow read, update: if isAuth() && resource.data.targetUid == request.auth.uid;
      // Any authenticated user can create notifications (for system-triggered notifications)
      allow create: if isAuth();
      // Authority can read all notifications
      allow read: if isAuthority();
    }
  }
}

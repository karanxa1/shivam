rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper function to get user role from users collection
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Role checks
    function isAdmin() {
      return isAuth() && (getRole() == "admin" || getRole() == "authority");
    }

    function isHR() {
      return isAuth() && getRole() == "hr";
    }

    function isAdminOrHR() {
      return isAdmin() || isHR();
    }

    function isEmployee() {
      return isAuth() && getRole() == "employee";
    }

    function isRegular() {
      return isAuth() && getRole() == "regular";
    }

    // Users collection
    match /users/{uid} {
      allow read: if request.auth.uid == uid || isAdminOrHR();
      allow create: if request.auth.uid == uid;
      allow update: if request.auth.uid == uid || isAdmin();
      allow delete: if isAdmin();
    }

    // Transactions collection - users can only access their own transactions
    // Admin can read/write all (for seeding / reporting)
    match /transactions/{txnId} {
      allow read, update, delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow read: if isAdmin();
    }

    // Budgets collection - users can only access their own budgets
    // Admin can read/write all (for seeding / reporting)
    match /budgets/{budgetId} {
      allow read, update, delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow read: if isAdmin();
    }

    // Employees collection - admin and HR can write, employees can read their own
    match /employees/{empId} {
      // Admin and HR have full access
      allow read, write: if isAdminOrHR();
      // Employee can read their own employee document
      allow read: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // Projects collection - admin can write, HR and employees can read
    match /projects/{projectId} {
      // Admin has full access
      allow read, write: if isAdmin();
      // HR can read projects
      allow read: if isHR();
      // Employees can read projects (to see assignments)
      allow read: if isAuth();
    }

    // Helper: verify employeeId (Firestore doc ID) belongs to the requesting user
    function isEmployeeOwner(employeeDocId) {
      return isAuth() &&
        employeeDocId != '' &&
        exists(/databases/$(database)/documents/employees/$(employeeDocId)) &&
        get(/databases/$(database)/documents/employees/$(employeeDocId)).data.uid == request.auth.uid;
    }

    // Tasks collection - admin can write, HR can read, employees can read/update their own
    match /tasks/{taskId} {
      // Admin has full access
      allow read, write: if isAdmin();
      // HR can read all tasks
      allow read: if isHR();
      // Employee can read and update (status) their own tasks
      allow read, update: if isEmployeeOwner(resource.data.employeeId);
    }

    // Payslips collection - admin and HR can write, employees can read their own
    match /payslips/{payslipId} {
      // Admin and HR have full access
      allow read, write: if isAdminOrHR();
      // Employee can read their own payslips only
      allow read: if isEmployeeOwner(resource.data.employeeId);
    }

    // Notifications collection - users can read/update their own notifications
    match /notifications/{notifId} {
      // Users can read and update (mark as read) their own notifications
      allow read, update: if isAuth() && resource.data.targetUid == request.auth.uid;
      // Any authenticated user can create notifications
      allow create: if isAuth();
      // Admin can read all notifications
      allow read: if isAdmin();
    }
  }
}
